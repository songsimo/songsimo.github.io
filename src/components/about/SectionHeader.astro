---
type Props = {
  /** 섹션 id. 제목 요소의 id(`${id}-title`)와 aria-labelledby 연결에 쓴다 */
  id: string;
  title: string;
  description?: string;
};

const { id, title, description } = Astro.props;
---

<header class="section__header">
  <h2 class="section__title" id={`${id}-title`}>{title}</h2>
  {description && <p class="section__desc">{description}</p>}
</header>
