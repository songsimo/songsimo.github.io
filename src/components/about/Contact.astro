---
import SectionHeader from "./SectionHeader.astro";
import { getAssetPath } from "@/utils/withBase";
import { contactLinks } from "@/data/about";

// 입력칸 정의: 이 배열만 고치면 필드가 늘어난다. (검증 규칙은 src/scripts/about/form.js)
type Field = {
  name: string;
  label: string;
  type: "text" | "email" | "textarea";
  autocomplete?: "name" | "email";
};

const fields: Field[] = [
  { name: "name", label: "이름", type: "text", autocomplete: "name" },
  { name: "email", label: "이메일", type: "email", autocomplete: "email" },
  { name: "message", label: "메시지", type: "textarea" },
];

---

<section
  class="section"
  id="contact"
  aria-labelledby="contact-title"
  tabindex="-1"
>
  <SectionHeader
    id="contact"
    title="연락하기"
    description="궁금한 점이나 제안이 있다면 편하게 남겨주세요."
  />

  <div class="contact">
    <form class="card form reveal" id="contact-form" novalidate>
      {
        fields.map(({ name, label, type, autocomplete }) => (
          <div class="field">
            <label for={`contact-${name}`}>{label}</label>
            {type === "textarea" ? (
              <textarea
                id={`contact-${name}`}
                name={name}
                rows="5"
                required
                aria-describedby={`contact-${name}-error`}
              />
            ) : (
              <input
                type={type}
                id={`contact-${name}`}
                name={name}
                autocomplete={autocomplete}
                required
                aria-describedby={`contact-${name}-error`}
              />
            )}
            <p
              class="field__error"
              id={`contact-${name}-error`}
              data-error-for={name}
            />
          </div>
        ))
      }

      <button class="button button--primary" type="submit">보내기</button>
      <p class="form__status" id="form-status" role="status"></p>
    </form>
  </div>
</section>
