---
import SectionHeader from "./SectionHeader.astro";
import { skillGroups } from "@/data/about";
---

<section
  class="section"
  id="skills"
  aria-labelledby="skills-title"
  tabindex="-1"
>
  <SectionHeader id="skills" title="기술 스택" />

  <ul class="skill-grid">
    {
      skillGroups.map(({ title, items }) => (
        <li class="card skill-group reveal">
          <h3 class="skill-group__title">{title}</h3>
          <ul class="chips">
            {items.map(item => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
