---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const latestPosts = sortedPosts.slice(0, postsConfig.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <div
    id="hero"
    class="border-border relative isolate flex h-[300px] flex-col overflow-hidden border-b sm:h-[380px] lg:h-[460px]"
  >
    <div class="absolute inset-0 left-1/2 -z-10 w-screen -translate-x-1/2">
      <img
        src={getAssetPath("images/banner-light.png")}
        alt=""
        width="1152"
        height="336"
        class="block h-full w-full object-cover dark:hidden"
      />
      <img
        src={getAssetPath("images/banner-dark.png")}
        alt=""
        width="1152"
        height="336"
        class="hidden h-full w-full object-cover dark:block"
      />
      <div
        class="bg-linear-to-b absolute inset-0 from-black/60 via-black/5 to-black/65"
      >
      </div>
    </div>

    <Header overlay />

    <div class="app-layout relative mt-auto pb-8">
      <span
        class="font-pixel mt-4 mb-2 inline-flex items-center gap-1 rounded-sm border border-white/25 bg-white/10 px-2 py-1 text-[10px] text-white uppercase backdrop-blur-sm"
      >
        ● Wayfarer 1
      </span>
      <p class="text-white/85">
        걸어온 길을 복기하며, 마주할 길을 항해합니다.
      </p>
      <p class="text-white/85 italic">
          Reflecting on the path taken, navigating what lies ahead.
      </p>
    </div>
  </div>

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="recent-posts" class="pt-8 pb-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-semibold tracking-wide">
          {t.home.recentPosts}
        </h2>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="hover:text-accent inline-block"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss width={18} height={18} class="rtl:-rotate-90" />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>
      <ul>
        {latestPosts.map(data => <Card variant="h3" {...data} />)}
      </ul>
    </section>

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="retro-shadow bg-muted px-4 py-2 text-sm font-medium"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>