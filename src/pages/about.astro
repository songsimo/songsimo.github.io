---
/**
 * /about — 프로필 페이지.
 *
 * 헤더 · 브레드크럼 · 푸터는 블로그의 Astro 컴포넌트를 그대로 쓰고,
 * <main> 안쪽(본문)만 프레임워크 없이 순수 HTML · CSS · JavaScript로 만든다.
 *
 *   마크업  이 파일의 <main> 안쪽 (Astro 문법 없이 순수 HTML)
 *   스타일  public/about/css/style.css  (.profile 안으로 한정)
 *   동작    public/about/js/*.js        (ES 모듈, defer)
 *   이미지  public/about/images/
 *
 * public/ 폴더의 파일은 Astro가 가공하지 않고 그대로 배포한다.
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout
  title={`프로필 | ${config.site.title}`}
  description="songsimo의 프로필 페이지. 본문은 프레임워크 없이 순수 HTML, CSS, JavaScript로 만들었습니다."
>
  <link slot="head" rel="stylesheet" href="/about/css/style.css" />

  <Header />

  <Breadcrumb />

  <main id="main-content" class="app-layout pb-4">
    <div class="profile" id="profile">
      <!-- ================= Hero ================= -->
      <section
        class="hero"
        id="hero"
        aria-labelledby="hero-title"
        tabindex="-1"
      >
        <p class="badge">
          <span class="badge__dot" aria-hidden="true">●</span>
          Wayfarer 1
        </p>
        <h1 class="hero__title" id="hero-title">
          안녕하세요,<br />
          <span class="accent">songsimo</span>입니다.
        </h1>
        <p class="hero__lead">
          배운 것은 블로그에 기록하고, 직접 만든 결과물을 모아둡니다.
        </p>
      </section>

      <!-- ============ 섹션 내비게이션 (모바일: 햄버거) ============ -->
      <nav class="page-nav" id="page-nav" aria-label="프로필 섹션">
        <div class="page-nav__bar">
          <span class="page-nav__title">프로필 목차</span>
          <button
            class="page-nav__toggle"
            id="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="page-nav-list"
            aria-label="섹션 메뉴 열기"
          >
            <span class="page-nav__bar-line" aria-hidden="true"></span>
            <span class="page-nav__bar-line" aria-hidden="true"></span>
            <span class="page-nav__bar-line" aria-hidden="true"></span>
          </button>
        </div>
        <ul class="page-nav__list" id="page-nav-list">
          <li><a href="#about">About</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>

      <!-- ================= About ================= -->
      <section
        class="section"
        id="about"
        aria-labelledby="about-title"
        tabindex="-1"
      >
        <header class="section__header">
          <h2 class="section__title" id="about-title">소개</h2>
        </header>

        <div class="about reveal">
          <figure class="about__figure">
            <img
              class="about__avatar"
              src="/about/images/avatar.svg"
              alt="초록색 후드를 입은 픽셀 아트 개발자 캐릭터"
              width="160"
              height="160"
              loading="lazy"
            />
          </figure>

          <div class="about__body">
            <p>
              이커머스에서 웹 개발 엔지니어로 일하고 있으며 제품을 개발할 때
              여러 방법을 고민하고 상황에 맞는 최선의 방법을 선택합니다. 장인
              정신을 중요하게 생각하고 비즈니스 가치를 높이기 위한 중요한
              방향성이라 생각합니다. 주도적으로 업무를 진행할 수 있는 환경을
              선호합니다.
            </p>
            <p>
              배운 것은 <a href="/">블로그</a>에 기록으로 남기고, 이 페이지에서
              직접 만든 결과물을 보여드립니다.
            </p>

            <dl class="facts">
              <div class="facts__row">
                <dt>주력</dt>
                <dd>Java, Spring, Spring Boot, Javascript</dd>
              </div>
              <div class="facts__row">
                <dt>학습 중</dt>
                <dd>AI</dd>
              </div>
              <div class="facts__row">
                <dt>기록</dt>
                <dd>개발 블로그</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <!-- ================= Skills ================= -->
      <section
        class="section"
        id="skills"
        aria-labelledby="skills-title"
        tabindex="-1"
      >
        <header class="section__header">
          <h2 class="section__title" id="skills-title">기술 스택</h2>
        </header>

        <ul class="skill-grid">
          <li class="card skill-group reveal">
            <h3 class="skill-group__title">Backend</h3>
            <ul class="chips">
              <li class="chip">Java</li>
              <li class="chip">Spring</li>
              <li class="chip">Spring Boot</li>
              <li class="chip">MyBatis</li>
            </ul>
          </li>
          <li class="card skill-group reveal">
            <h3 class="skill-group__title">Database</h3>
            <ul class="chips">
              <li class="chip">Oracle</li>
              <li class="chip">PostgreSQL</li>
            </ul>
          </li>
          <li class="card skill-group reveal">
            <h3 class="skill-group__title">Frontend</h3>
            <ul class="chips">
              <li class="chip">HTML5</li>
              <li class="chip">CSS3</li>
              <li class="chip">JavaScript ES6+</li>
              <li class="chip">VueJS</li>
              <li class="chip">JQuery</li>
            </ul>
          </li>
          <li class="card skill-group reveal">
            <h3 class="skill-group__title">Tools</h3>
            <ul class="chips">
              <li class="chip">Git</li>
              <li class="chip">GitHub</li>
            </ul>
          </li>
        </ul>
      </section>

      <!-- ================= Projects ================= -->
      <section
        class="section"
        id="projects"
        aria-labelledby="projects-title"
        tabindex="-1"
      >
        <header class="section__header">
          <h2 class="section__title" id="projects-title">프로젝트</h2>
          <p class="section__desc">
            GitHub 공개 저장소를 불러와서 보여줍니다. (최근 업데이트 순)
          </p>
        </header>

        <!--
          저장소 카드는 브라우저에서 GitHub API로 불러와 채운다 (js/repos.js).
          GitHub 아이디와 보여줄 개수는 data-* 속성으로 스크립트에 넘긴다.
        -->
        <div
          id="repo-container"
          data-github-user="songsimo"
          data-repo-limit="6"
          aria-live="polite"
          aria-busy="true"
        >
          <div class="state" id="repo-state" hidden></div>
          <ul class="repo-grid" id="repo-grid"></ul>
        </div>

        <noscript>
          <p class="state">
            JavaScript를 켜면 저장소 목록이 보여요.
            <a href="https://github.com/songsimo?tab=repositories"
              >GitHub에서 바로 보기</a
            >
          </p>
        </noscript>
      </section>

      <!-- ================= Contact ================= -->
      <section
        class="section"
        id="contact"
        aria-labelledby="contact-title"
        tabindex="-1"
      >
        <header class="section__header">
          <h2 class="section__title" id="contact-title">연락하기</h2>
          <p class="section__desc">
            궁금한 점이나 제안이 있다면 편하게 남겨주세요.
          </p>
        </header>

        <div class="contact">
          <form class="card form reveal" id="contact-form" novalidate>
            <div class="field">
              <label for="contact-name">이름</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                autocomplete="name"
                required
                aria-describedby="contact-name-error"
              />
              <p
                class="field__error"
                id="contact-name-error"
                data-error-for="name"
              >
              </p>
            </div>

            <div class="field">
              <label for="contact-email">이메일</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                autocomplete="email"
                required
                aria-describedby="contact-email-error"
              />
              <p
                class="field__error"
                id="contact-email-error"
                data-error-for="email"
              >
              </p>
            </div>

            <div class="field">
              <label for="contact-message">메시지</label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                aria-describedby="contact-message-error"></textarea>
              <p
                class="field__error"
                id="contact-message-error"
                data-error-for="message"
              >
              </p>
            </div>

            <button class="button button--primary" type="submit">보내기</button>
            <p class="form__status" id="form-status" role="status"></p>
          </form>
        </div>
      </section>

      <!-- ================= 맨 위로 ================= -->
      <button
        class="scroll-top"
        id="scroll-top"
        type="button"
        aria-label="페이지 맨 위로 이동"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 19V5M5 12l7-7 7 7"></path>
        </svg>
      </button>
    </div>
  </main>

  <Footer />

  <!--
    ES 모듈은 기본으로 지연(defer) 실행된다. 같은 주소의 모듈은 한 번만 실행되므로,
    블로그의 페이지 전환(ClientRouter) 중에도 다시 실행되지 않는다.
    화면 초기화는 main.js가 astro:page-load 이벤트에서 한다.
  -->
  <script is:inline type="module" defer src="/about/js/main.js"></script>
</Layout>